<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
    <title>@ViewData["Title"] - Inventario Pro</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <style>
        body { 
            background: #f8fafc; /* Very light blue-gray for modern SaaS feel */
            font-family: 'Inter', sans-serif;
            color: #334155;
        }
        
        /* Modern Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* General Utilities */
        .fw-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .card-d { border: none; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,.05), 0 2px 4px -2px rgba(0,0,0,.05); transition: all 0.2s ease-in-out; }
        .card-d:hover { box-shadow: 0 10px 15px -3px rgba(0,0,0,.08), 0 4px 6px -4px rgba(0,0,0,.04); }
        
        /* Badges */
        .badge-pos { background-color: #0ea5e9; color: #fff; }
        .badge-directa { background-color: #6366f1; color: #fff; }
        .badge-contado { background-color: #10b981; color: #fff; }
        .badge-credito { background-color: #f59e0b; color: #fff; }

        /* Navbar & Sidebar */
        .navbar-brand { font-weight: 800; letter-spacing: -0.5px; font-size: 1.25rem; }
        .navbar-custom { background: #ffffff; border-bottom: 1px solid #f1f5f9; }
        
        .sidebar { 
            min-height: calc(100vh - 60px); 
            background: #ffffff; 
            border-right: 1px solid #f1f5f9;
        }
        .sidebar .sec { 
            color: #94a3b8; 
            font-size: 0.7rem; 
            font-weight: 700;
            text-transform: uppercase; 
            padding: 24px 20px 8px; 
            letter-spacing: 1.5px;
        }
        .sidebar .nav-link { 
            color: #64748b; 
            padding: 10px 20px; 
            border-radius: 8px; 
            margin: 2px 12px;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }
        .sidebar .nav-link:hover { 
            color: #0f172a; 
            background: #f8fafc; 
        }
        .sidebar .nav-link.active { 
            color: #2563eb; 
            background: #eff6ff;
            font-weight: 600;
        }
        .sidebar .nav-link i { 
            margin-right: 12px; 
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
        }
        .sidebar .nav-link.active i {
            color: #2563eb;
        }
        
    </style>
</head>
<body>

@if (Context.Session.GetString("UserName") != null) {
<nav class="navbar navbar-expand-lg navbar-custom sticky-top py-2 shadow-sm">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-dark d-flex align-items-center" href="/">
            <div class="bg-primary text-white rounded p-1 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-box-seam fs-5"></i>
            </div>
            Inventario Pro
        </a>
        
        <div class="d-flex align-items-center gap-3 ms-auto">
            <div class="d-none d-md-flex align-items-center">
                <div class="text-end me-3">
                    <div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.2;">@Context.Session.GetString("UserName")</div>
                    <div class="text-muted small" style="font-size: 0.75rem;">Administrador</div>
                </div>
                <div class="bg-light rounded-circle border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-person text-secondary fs-5"></i>
                </div>
            </div>
            <div class="vr d-none d-md-block mx-1"></div>
            <a href="/Login/Logout" class="btn btn-light border btn-sm text-danger shadow-sm py-2 px-3 fw-semibold">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-none d-md-block sidebar py-3 px-0">
            <ul class="nav flex-column">
                <div class="sec">Catálogo</div>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Productos"?"active":"")" href="/Productos">
                        <i class="bi bi-box2"></i> Productos
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Categorias"?"active":"")" href="/Categorias">
                        <i class="bi bi-tags"></i> Categorías
                    </a>
                </li>
                
                <div class="sec">Ventas / Salidas</div>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Ventas"&&ViewContext.RouteData.Values["action"]?.ToString()=="Create"?"active":"")" href="/Ventas/Create">
                        <i class="bi bi-cart-plus"></i> Terminal POS
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Ventas"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Ventas">
                        <i class="bi bi-receipt"></i> Historial Ventas
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Ventas"&&ViewContext.RouteData.Values["action"]?.ToString()=="Reportes"?"active":"")" href="/Ventas/Reportes">
                        <i class="bi bi-graph-up-arrow"></i> Tablero General
                    </a>
                </li>
                
                <div class="sec">Compras / Entradas</div>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Compras"&&ViewContext.RouteData.Values["action"]?.ToString()=="Create"?"active":"")" href="/Compras/Create">
                        <i class="bi bi-truck"></i> Ingresar Stock
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Compras"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Compras">
                        <i class="bi bi-invoices"></i> Historial Compras
                    </a>
                </li>
                
                <div class="sec">Directorio</div>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Clientes"?"active":"")" href="/Clientes">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-5 py-4 pb-5">
            @RenderBody()
        </main>
    </div>
</div>
} else { 
    <!-- Login layout -->
    <main class="col-12 vh-100 d-flex align-items-center justify-content-center bg-light">
        @RenderBody()
    </main> 
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Global Toast Notification System based on TempData -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        @if (TempData["Exito"] != null)
        {
            <text>
            Toast.fire({
                icon: 'success',
                title: '@Html.Raw(TempData["Exito"].ToString().Replace("'", "\\'"))'
            });
            </text>
        }
        
        @if (TempData["Error"] != null)
        {
            <text>
            Toast.fire({
                icon: 'error',
                title: '@Html.Raw(TempData["Error"].ToString().Replace("'", "\\'"))'
            });
            </text>
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>