@{
    ViewData["Title"] = "Panel de Reportes";
    var porDia   = ViewBag.VentasPorDia   as IEnumerable<dynamic> ?? new List<dynamic>();
    var topProds = ViewBag.TopProductos   as IEnumerable<dynamic> ?? new List<dynamic>();
    var porTipo  = ViewBag.VentasPorTipo  as IEnumerable<dynamic> ?? new List<dynamic>();
    var porPago  = ViewBag.VentasPorPago  as IEnumerable<dynamic> ?? new List<dynamic>();
    
    decimal totalGeneral = ViewBag.TotalGeneral ?? 0m;
    decimal totalHoy     = ViewBag.TotalHoy     ?? 0m;
    int totalVentas      = ViewBag.TotalVentas   ?? 0;
    int pos = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Reportes de Ventas</h2>
        <p class="text-muted small mb-0">Métricas clave, rendimiento de productos y análisis financiero</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i>Regresar a Ventas</a>
</div>

<!-- KPI ROW -->
<div class="row g-4 mb-4">
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">
            <div class="card-body p-4 position-relative text-white">
                <i class="bi bi-wallet2 position-absolute" style="font-size: 6rem; right: -10px; bottom: -20px; opacity: 0.15;"></i>
                <div class="text-white-50 text-uppercase small fw-bold mb-1">Ingresos Históricos Totales</div>
                <div class="display-5 fw-bold mb-0">$@totalGeneral.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
            <div class="card-body p-4 position-relative text-white">
                <i class="bi bi-graph-up-arrow position-absolute" style="font-size: 6rem; right: -10px; bottom: -20px; opacity: 0.15;"></i>
                <div class="text-white-50 text-uppercase small fw-bold mb-1">Ingresos del Día de Hoy</div>
                <div class="display-5 fw-bold mb-0">$@totalHoy.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-12">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
            <div class="card-body p-4 position-relative text-white">
                <i class="bi bi-receipt-cutoff position-absolute" style="font-size: 6rem; right: -10px; bottom: -20px; opacity: 0.15;"></i>
                <div class="text-white-50 text-uppercase small fw-bold mb-1">Transacciones Exitosas</div>
                <div class="display-5 fw-bold mb-0">@totalVentas <span class="fs-4 fw-normal text-white-50">ventas</span></div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <div class="col-xl-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-calendar-week me-2 text-primary"></i>Ingresos de los Últimos 7 Días</h6>
            </div>
            <div class="card-body p-4">
                @if(!porDia.Any()) {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 opacity-50 mb-3 block"></i>
                        <p>No se registraron ventas en esta semana.</p>
                    </div>
                } else {
                    <div style="height: 300px; width: 100%;">
                        <canvas id="chartVentasDia"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-xl-4 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-pie-chart me-2 text-success"></i>Por Modalidad de Venta</h6>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                @if(!porTipo.Any()) {
                    <p class="text-muted small">Sin datos.</p>
                } else {
                    <div style="height: 250px; width: 100%; position: relative;">
                        <canvas id="chartTipos"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW -->
<div class="row g-4 mb-4">
    <!-- TOP PRODUCTOS -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-trophy text-warning me-2"></i>Top 5 Productos Más Vendidos</h6>
            </div>
            <div class="card-body p-0">
                @if(!topProds.Any()){
                    <div class="text-center py-4 text-muted small">Sin datos suficientes para calcular ranking.</div>
                } else {
                    <ul class="list-group list-group-flush">
                    @foreach(var p in topProds){
                        pos++;
                        var badgeColor = pos == 1 ? "bg-warning text-dark" : pos == 2 ? "bg-secondary" : pos == 3 ? "bg-danger bg-opacity-75" : "bg-dark bg-opacity-50 text-white";
                        var icon = pos == 1 ? "<i class='bi bi-star-fill text-warning shadow-sm me-2'></i>" : "";
                        
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @badgeColor rounded-pill shadow-sm" style="font-size:0.8rem; width: 30px; height: 30px; display:flex; align-items:center; justify-content:center;">#@pos</span>
                                <div>
                                    <h6 class="mb-0 fw-bold text-dark d-flex align-items-center">@Html.Raw(icon)@p.Nombre</h6>
                                    <small class="text-muted"><i class="bi bi-box-seam me-1"></i>Vendidos: <strong>@p.Cantidad unidades</strong></small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-uppercase small text-muted fw-bold" style="font-size: 0.65rem">Generado</div>
                                <div class="fw-bold text-success fs-5">$@(((decimal)p.Ingresos).ToString("N2"))</div>
                            </div>
                        </li>
                    }
                    </ul>
                }
            </div>
        </div>
    </div>
    
    <!-- POR TIPO PAGO -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-credit-card text-info me-2"></i>Desglose por Método de Pago</h6>
            </div>
            <div class="card-body p-0">
                @if(!porPago.Any()){
                    <div class="text-center py-4 text-muted small">Sin datos registrados.</div>
                } else {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4">Método</th>
                                    <th class="text-center">Operaciones</th>
                                    <th class="text-end pe-4">Ingresos ($)</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @foreach(var t in porPago){
                                    var isContado = t.Tipo == "Contado";
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-@(isContado?"success":"warning") bg-opacity-10 text-@(isContado?"success":"warning") rounded-circle p-2 me-3">
                                                    <i class="bi @(isContado?"bi-cash-stack":"bi-credit-card-2-back")"></i>
                                                </div>
                                                <span class="fw-semibold text-dark">@(isContado?"Pago al Contado":"Pago a Crédito")</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary rounded-pill">@t.Count ops.</span>
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-success fs-6">
                                            $@(((decimal)t.Total).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // ----------------------------------------------------
            // 1) CHART: VENTAS ULTIMOS 7 DIAS (Bar)
            // ----------------------------------------------------
            const labels7D = [
                @foreach(var d in porDia) {
                    var ds = (d.Fecha as DateTime?)?.ToString("dd MMM") ?? d.Fecha.ToString();
                    <text>'@ds',</text>
                }
            ];
            
            const data7D = [
                @foreach(var d in porDia) {
                    <text>@((decimal)d.Total),</text>
                }
            ];

            if(labels7D.length > 0) {
                const ctxD = document.getElementById('chartVentasDia').getContext('2d');
                
                // create gradient
                let gradient = ctxD.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, 'rgba(14, 165, 233, 0.8)');   
                gradient.addColorStop(1, 'rgba(14, 165, 233, 0.2)');

                new Chart(ctxD, {
                    type: 'bar',
                    data: {
                        labels: labels7D,
                        datasets: [{
                            label: 'Ingresos ($)',
                            data: data7D,
                            backgroundColor: gradient,
                            hoverBackgroundColor: '#0ea5e9',
                            borderRadius: 6,
                            borderWidth: 0,
                            barPercentage: 0.6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed.y !== null) {
                                            label += new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(context.parsed.y);
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                grid: { color: 'rgba(0,0,0,0.04)' },
                                ticks: { 
                                    font: { size: 11 },
                                    callback: function(value, index, values) {
                                        return '$' + value;
                                    }
                                }
                            },
                            x: {
                                border: { display: false },
                                grid: { display: false },
                                ticks: { font: { size: 11 } }
                            }
                        }
                    }
                });
            }

            // ----------------------------------------------------
            // 2) CHART: POR MODALIDAD (Doughnut)
            // ----------------------------------------------------
            const labelsTipo = [
                @foreach(var t in porTipo) {
                    <text>'@t.Tipo',</text>
                }
            ];
            const dataTipo = [
                @foreach(var t in porTipo) {
                    <text>@((decimal)t.Total),</text>
                }
            ];

            if(labelsTipo.length > 0) {
                const ctxT = document.getElementById('chartTipos').getContext('2d');
                new Chart(ctxT, {
                    type: 'doughnut',
                    data: {
                        labels: labelsTipo,
                        datasets: [{
                            data: dataTipo,
                            backgroundColor: [
                                '#10b981', // green for POS usually
                                '#6366f1', // indigo for Directa
                                '#f59e0b'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20,
                                    font: { size: 12 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed !== null) {
                                            label += new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(context.parsed);
                                        }
                                        return label;
                                    }
                                }
                            }
                        }
                    }
                });
            }

        });
    </script>
}