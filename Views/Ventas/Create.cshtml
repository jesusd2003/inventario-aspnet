@model InventarioApp.Models.VentaCreateVM
@{ ViewData["Title"]="Nueva Venta"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-cart-check text-primary me-2"></i>Terminal de Venta</h2>
        <p class="text-muted small mb-0">Registra una nueva transacción y genera un folio</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i>Regresar al Historial</a>
</div>

@if (!ViewData.ModelState.IsValid) {
    <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center">
        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
        <div>
            <h6 class="mb-1 fw-bold">No se pudo procesar la venta</h6>
            @Html.ValidationSummary(false,"",new{@class="mb-0 small"})
        </div>
    </div>
}

<form asp-action="Create" method="post" id="fventa">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Panel Izquierdo: Configuración y Totales -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Datos del Cliente</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="ClienteId" class="form-label fw-semibold small text-muted">Cliente Registrado</label>
                        <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select shadow-sm" required>
                            <option value="">-- Público General / Seleccionar --</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger small"></span>
                        <div class="mt-2 text-end">
                            <a asp-controller="Clientes" asp-action="Create" class="text-decoration-none small text-primary fw-semibold"><i class="bi bi-plus-circle me-1"></i>Registrar nuevo cliente</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Configuración de Venta</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="TipoVenta" class="form-label fw-semibold small text-muted">Tipo</label>
                            <select asp-for="TipoVenta" class="form-select shadow-sm">
                                <option value="POS">Punto de Venta</option>
                                <option value="Directa">Venta Directa</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label asp-for="TipoPago" class="form-label fw-semibold small text-muted">Pago</label>
                            <select asp-for="TipoPago" class="form-select shadow-sm">
                                <option value="Contado">Al Contado</option>
                                <option value="Credito">A Crédito</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Notas" class="form-label fw-semibold small text-muted">Observaciones Adicionales</label>
                        <textarea asp-for="Notas" class="form-control shadow-sm" rows="2" placeholder="Ej. Entregar por la tarde..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Gran Total -->
            <div class="card border-0 shadow-lg rounded-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white;">
                <div class="card-body p-4 text-center">
                    <div class="text-white-50 small fw-bold tracking-wide mb-2 text-uppercase">Total a Cobrar</div>
                    <div class="fw-bold text-success" style="font-size: 3rem; line-height: 1" id="lblTotal">$0.00</div>
                    <hr class="border-secondary opacity-25 my-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm d-flex justify-content-center align-items-center">
                        <i class="bi bi-check-circle fs-5 me-2"></i> Procesar Venta
                    </button>
                    <a asp-action="Index" class="btn btn-link text-white-50 text-decoration-none mt-2 btn-sm w-100">Cancelar y salir</a>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Productos -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-4">
                    <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-cart4 me-2 text-primary"></i>Gestión de Artículos</h6>
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-primary text-white border-primary"><i class="bi bi-upc-scan"></i></span>
                        <input type="text" id="posSearch" class="form-control border-primary form-control-lg" placeholder="Escanea código de barras o escribe nombre / ID..." autofocus autocomplete="off"/>
                        <button class="btn btn-primary px-4 fw-bold" type="button" id="btnSearch"><i class="bi bi-search me-1"></i>Buscar</button>
                    </div>
                    <div class="text-muted small mt-2"><i class="bi bi-keyboard ms-1 me-1"></i>Presiona <strong>Enter</strong> para agregar rápido. Al escanear, el código será procesado automáticamente.</div>
                </div>
                <div class="card-body p-0">
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="tbl" style="min-width: 600px;">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4" style="width:40%">Producto</th>
                                    <th style="width:15%" class="text-center">Cant.</th>
                                    <th style="width:20%" class="text-end">Precio Unit.</th>
                                    <th style="width:20%" class="text-end pe-4">Subtotal</th>
                                    <th style="width:5%"></th>
                                </tr>
                            </thead>
                            <tbody id="tbody" class="border-top-0">
                                <!-- Filas dinamicas -->
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold text-secondary text-uppercase py-3">Total Venta:</td>
                                    <td class="text-end fw-bold text-success fs-5 pe-4 py-3" id="totalTd">$0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    
                    <div id="noItems" class="text-center py-5">
                        <div class="mb-3"><i class="bi bi-basket fs-1 text-muted opacity-25"></i></div>
                        <h6 class="text-muted fw-semibold">Tu carrito está vacío</h6>
                        <p class="text-muted small">Usa el buscador superior para agregar productos.</p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
    const prods = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((List<InventarioApp.Models.Producto>)ViewBag.Productos).Select(p=>new{
            p.Id,
            p.Nombre,
            p.Precio,
            p.Stock,
            cat=p.Categoria!=null ? p.Categoria.Nombre : "Sin categoría"
        })
    ));
    
    let idx = 0;
    const searchInput = document.getElementById("posSearch");
    
    // Evitar que enter envíe el formulario global
    document.getElementById("fventa").addEventListener("keydown", function(e) {
        if(e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
            e.preventDefault();
            return false;
        }
    });

    searchInput.addEventListener('keydown', function(e) {
        if(e.key === 'Enter') {
            e.preventDefault();
            processSearch(this.value.trim());
        }
    });

    document.getElementById("btnSearch").addEventListener("click", () => {
        processSearch(searchInput.value.trim());
    });

    const Toast = Swal.mixin({
        toast: true, position: 'top-end', showConfirmButton: false, timer: 3000
    });

    function processSearch(query) {
        if(!query) return;
        
        // Match exact ID first, then fuzzy name search
        let match = prods.find(p => p.Id.toString() === query.toString());
        if(!match) {
            match = prods.find(p => p.Nombre.toLowerCase().includes(query.toLowerCase()));
        }

        if(!match) {
            Toast.fire({ icon: 'error', title: 'Producto no encontrado' });
            searchInput.select();
            return;
        }

        if(match.Stock <= 0) {
            Toast.fire({ icon: 'error', title: 'Sujeto sin stock disponible (' + match.Nombre + ')' });
            searchInput.select();
            return;
        }

        addProductToCart(match);
        searchInput.value = '';
        searchInput.focus();
    }

    function addProductToCart(p) {
        document.getElementById("noItems").style.display = "none";
        
        // Verify if product is already in cart, increment quantity
        const existingRows = document.querySelectorAll("#tbody tr");
        for(let row of existingRows) {
            const hiddenId = row.querySelector("input[type=hidden].p-id");
            if(hiddenId && hiddenId.value == p.Id) {
                const cantInput = row.querySelector("input[type=number]");
                let current = parseInt(cantInput.value) || 0;
                if(current + 1 > p.Stock) {
                    Toast.fire({ icon: 'warning', title: 'Stock máximo alcanzado para ' + p.Nombre });
                    return;
                }
                cantInput.value = current + 1;
                // Dispatch input event to trigger calculation
                cantInput.dispatchEvent(new Event('input'));
                Toast.fire({ icon: 'success', title: 'Cantidad +1 añadida', timer: 1500 });
                return;
            }
        }

        // Add new row
        const tr = `<tr id="r${idx}">
            <td class="ps-4">
                <input type="hidden" name="Items[${idx}].ProductoId" class="p-id" value="${p.Id}" />
                <div class="fw-bold text-dark mb-1">${p.Nombre}</div>
                <div class="small text-muted"><span class="badge bg-light text-secondary border me-1">ID: ${p.Id}</span> Disp: ${p.Stock}</div>
            </td>
            <td>
                <input type="number" name="Items[${idx}].Cantidad" class="form-control text-center fw-bold text-primary shadow-sm" value="1" min="1" max="${p.Stock}" oninput="upd(${idx})" required/>
            </td>
            <td class="text-end">
                <span class="pr fw-semibold text-muted">$${p.Precio.toFixed(2)}</span>
                <input type="hidden" class="pv" value="${p.Precio}"/>
            </td>
            <td class="text-end pe-4">
                <span class="st fw-bold text-success">$${p.Precio.toFixed(2)}</span>
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-light text-danger border shadow-sm rounded-circle" onclick="delRow(${idx})" title="Quitar">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        </tr>`;
        
        document.getElementById("tbody").insertAdjacentHTML("afterbegin", tr);
        idx++;
        calcTotal();
        Toast.fire({ icon: 'success', title: 'Agregado al ticket: ' + p.Nombre, timer: 1500 });
    }

    function upd(i){
        const r = document.getElementById("r" + i);
        if(!r) return;
        
        const cantInput = r.querySelector("input[type=number]");
        let cant = parseInt(cantInput.value) || 0;
        let pId = r.querySelector("input[type=hidden].p-id").value;
        const p = prods.find(x => x.Id == pId);
        
        if (p) {
            if(cant > p.Stock) {
                cant = p.Stock;
                cantInput.value = cant;
                Toast.fire({ icon: 'warning', title: 'Solo hay ' + p.Stock + ' unidades de ' + p.Nombre });
            }
        }
        
        const precioVal = parseFloat(r.querySelector(".pv").value) || 0;
        const sub = cant * precioVal;
        r.querySelector(".st").textContent = "$" + sub.toFixed(2);
        calcTotal();
    }

    function delRow(i){
        const r = document.getElementById("r" + i);
        if(r) r.remove();
        calcTotal();
        if(!document.querySelectorAll("#tbody tr").length) {
            document.getElementById("noItems").style.display = "block";
        }
        searchInput.focus();
    }

    function calcTotal(){
        let t = 0;
        document.querySelectorAll(".st").forEach(e => {
            t += parseFloat(e.textContent.replace("$","")) || 0;
        });
        const f = "$" + t.toFixed(2);
        document.getElementById("totalTd").textContent = f;
        document.getElementById("lblTotal").textContent = f;
    }
    
    // Initialize focus
    window.onload = () => { searchInput.focus(); }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}