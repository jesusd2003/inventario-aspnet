@model InventarioApp.Models.Venta
@{ ViewData["Title"]="Folio de Venta #"+Model.Id; }

<style>
    @@media print {
        body * { visibility: hidden; }
        #print-area, #print-area * { visibility: visible; }
        #print-area { position: absolute; left: 0; top: 0; width: 100%; }
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        .card-header { background-color: transparent !important; border-bottom: 2px solid #dee2e6 !important; }
        .badge { border: 1px solid #000; color: #000 !important; background: transparent !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Detalle de Venta</h2>
        <p class="text-muted small mb-0">Consulta o imprime el comprobante de la transacción</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-dark shadow-sm"><i class="bi bi-printer me-1"></i>Imprimir Factura</button>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i>Regresar</a>
    </div>
</div>

<div class="row justify-content-center" id="print-area">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <!-- Invoice Header -->
            <div class="card-header bg-white border-bottom p-4 p-md-5">
                <div class="row align-items-center">
                    <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center justify-content-center justify-content-sm-start">
                            <i class="bi bi-box-seam text-primary me-2"></i>Inventario Pro
                        </h2>
                        <p class="text-muted small mb-0">Ticket de Compra / Remisión</p>
                    </div>
                    <div class="col-sm-6 text-center text-sm-end">
                        <div class="text-muted text-uppercase small fw-bold mb-1">Folio o Recibo</div>
                        <h3 class="fw-bold text-danger mb-0">NO. @Model.Id.ToString("D6")</h3>
                    </div>
                </div>
            </div>

            <!-- Invoice Body -->
            <div class="card-body p-4 p-md-5">
                <div class="row g-4 mb-5">
                    <div class="col-sm-6">
                        <div class="text-muted text-uppercase small fw-bold mb-2">Facturado a:</div>
                        <h5 class="fw-bold text-dark mb-1">@(Model.Cliente?.Nombre ?? "Cliente de Mostrador / General")</h5>
                        @if (Model.Cliente != null && !string.IsNullOrEmpty(Model.Cliente.Telefono)) {
                            <div class="text-muted small"><i class="bi bi-telephone text-secondary me-1"></i>@Model.Cliente.Telefono</div>
                        }
                        @if (Model.Cliente != null && !string.IsNullOrEmpty(Model.Cliente.Direccion)) {
                            <div class="text-muted small mt-1"><i class="bi bi-geo-alt text-secondary me-1"></i>@Model.Cliente.Direccion</div>
                        }
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        <div class="text-muted text-uppercase small fw-bold mb-2">Detalles de Emisión:</div>
                        <div class="mb-1"><span class="text-muted me-2">Fecha:</span> <span class="fw-semibold">@Model.Fecha.ToString("dd MMMM yyyy, HH:mm")</span></div>
                        <div class="mb-1"><span class="text-muted me-2">Modalidad:</span> <span class="badge @(Model.TipoVenta==InventarioApp.Models.TipoVenta.POS?"bg-info":"bg-primary") bg-opacity-10 text-dark border px-2 py-1">@Model.TipoVenta</span></div>
                        <div class="mb-1"><span class="text-muted me-2">Forma de Pago:</span> <span class="badge @(Model.TipoPago==InventarioApp.Models.TipoPago.Contado?"bg-success":"bg-warning") bg-opacity-10 text-dark border px-2 py-1">@Model.TipoPago</span></div>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-borderless table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3 py-3 rounded-start">Descripción del Producto</th>
                                <th class="text-center py-3">Cant.</th>
                                <th class="text-end py-3">Precio Unit.</th>
                                <th class="text-end pe-3 py-3 rounded-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var d in Model.Detalles) {
                                <tr>
                                    <td class="ps-3 py-3 fw-semibold text-dark">@(d.Producto?.Nombre ?? "Producto Eliminado")</td>
                                    <td class="text-center py-3">@d.Cantidad</td>
                                    <td class="text-end py-3 text-muted">$@d.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end pe-3 py-3 fw-bold text-success">$@d.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row">
                    <div class="col-md-7 mb-4 mb-md-0">
                        @if(!string.IsNullOrEmpty(Model.Notas)) {
                            <div class="bg-light p-3 rounded-3 border">
                                <h6 class="fw-bold small text-secondary text-uppercase mb-2"><i class="bi bi-stickies me-1"></i>Notas y Observaciones</h6>
                                <p class="small text-muted mb-0">@Model.Notas</p>
                            </div>
                        }
                        
                        <div class="mt-4 text-muted small">
                            <i class="bi bi-shield-check text-success me-1"></i> Documento generado por el sistema automatizado.
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 rounded-3">
                            <div class="card-body p-4 text-end">
                                <div class="text-muted text-uppercase small fw-bold mb-1">Total Pagado</div>
                                <h2 class="fw-bold text-success mb-0">$@Model.Total.ToString("N2")</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-light border-top-0 text-center py-3">
                <span class="text-muted small">¡Gracias por su preferencia!</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            if(params.get('print') === 'true') {
                setTimeout(() => window.print(), 600);
            }
        });
    </script>
}