@model InventarioApp.Models.Cliente
@{ ViewData["Title"]="Historial de " + Model.Nombre; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 shadow-sm"><i class="bi bi-arrow-left"></i> Regresar</a>
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-person-circle text-primary me-2"></i>@Model.Nombre</h2>
            <p class="text-muted small mb-0"><i class="bi bi-telephone text-muted me-1"></i>@(string.IsNullOrEmpty(Model.Telefono) ? "Sin teléfono registrado" : Model.Telefono) <span class="mx-2">|</span> <i class="bi bi-geo-alt text-muted me-1"></i>@(string.IsNullOrEmpty(Model.Direccion) ? "Sin dirección" : Model.Direccion)</p>
        </div>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm"><i class="bi bi-pencil-square me-1"></i>Editar Perfil</a>
</div>

<!-- KPI Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 border-bottom border-4 border-primary h-100">
            <div class="card-body p-4 text-center">
                <div class="text-muted small fw-bold text-uppercase mb-2">Total de Compras</div>
                <div class="display-6 fw-bold text-dark">@Model.Ventas.Count</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 border-bottom border-4 border-success h-100">
            <div class="card-body p-4 text-center">
                <div class="text-muted small fw-bold text-uppercase mb-2">Total de Ingresos</div>
                <div class="display-6 fw-bold text-success">$@Model.Ventas.Sum(v=>v.Total).ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <div class="text-muted small fw-bold text-uppercase mb-2">Modalidad Preferida</div>
                @if(Model.Ventas.Count > 0){
                    var pos = Model.Ventas.Count(v=>v.TipoVenta==InventarioApp.Models.TipoVenta.POS);
                    var dir = Model.Ventas.Count(v=>v.TipoVenta==InventarioApp.Models.TipoVenta.Directa);
                    <div class="fs-4 fw-bold text-dark mt-2">@(pos >= dir ? "Punto de Venta" : "Venta Directa")</div>
                } else {
                    <div class="fs-4 fw-bold text-muted mt-2">-</div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-center text-uppercase mb-3">Estadística de pagos</div>
                <div class="d-flex justify-content-between align-items-center px-2 mb-2">
                    <span class="small fw-semibold text-secondary"><i class="bi bi-cash text-success me-1"></i> Al Contado</span>
                    <span class="badge bg-success rounded-pill">@Model.Ventas.Count(v=>v.TipoPago==InventarioApp.Models.TipoPago.Contado)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center px-2">
                    <span class="small fw-semibold text-secondary"><i class="bi bi-credit-card text-warning me-1"></i> A Crédito</span>
                    <span class="badge bg-warning text-dark rounded-pill">@Model.Ventas.Count(v=>v.TipoPago==InventarioApp.Models.TipoPago.Credito)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom py-4 px-4 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-secondary text-uppercase"><i class="bi bi-clock-history text-primary me-2"></i>Historial de Transacciones</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Ventas.Any()) {
            <div class="text-center py-5">
                <div class="mb-3"><i class="bi bi-receipt fs-1 text-muted opacity-50"></i></div>
                <h5 class="text-muted fw-semibold">Historial limpio</h5>
                <p class="text-muted small mb-0">Este cliente aún no ha registrado ninguna transacción en el sistema.</p>
                <a asp-controller="Ventas" asp-action="Create" class="btn btn-outline-primary mt-3 btn-sm">Realizar una venta a su nombre</a>
            </div>
        } else {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">Folio</th>
                            <th>Fecha</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Pago</th>
                            <th class="text-center">Artículos</th>
                            <th class="text-end">Total de Venta</th>
                            <th class="text-center pe-4">Recibo</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                    @foreach (var v in Model.Ventas.OrderByDescending(x=>x.Fecha)) {
                        <tr>
                            <td class="ps-4 text-muted small fw-mono">#@v.Id.ToString("D5")</td>
                            <td>
                                <div class="fw-semibold text-dark">@v.Fecha.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small"><i class="bi bi-clock me-1"></i>@v.Fecha.ToString("HH:mm")</div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(v.TipoVenta==InventarioApp.Models.TipoVenta.POS?"bg-info":"bg-primary") bg-opacity-10 text-dark border px-2 py-1 rounded-pill">
                                    <i class="bi @(v.TipoVenta==InventarioApp.Models.TipoVenta.POS?"bi-shop":"bi-truck") me-1"></i>@v.TipoVenta
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(v.TipoPago==InventarioApp.Models.TipoPago.Contado?"bg-success":"bg-warning") bg-opacity-10 text-dark border px-2 py-1 rounded-pill">
                                    <i class="bi @(v.TipoPago==InventarioApp.Models.TipoPago.Contado?"bi-cash":"bi-credit-card") me-1"></i>@v.TipoPago
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary rounded-pill">@v.Detalles.Count</span>
                            </td>
                            <td class="text-end fw-bold text-success">
                                $@v.Total.ToString("N2")
                            </td>
                            <td class="text-center pe-4">
                                <a asp-controller="Ventas" asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-light border text-info shadow-sm" title="Ver Factura"><i class="bi bi-receipt-cutoff"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>