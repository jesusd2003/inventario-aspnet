@model InventarioApp.Models.Categoria
@{ ViewData["Title"]="Nueva Categoría"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-tag text-primary me-2"></i>Nueva Categoría</h2>
        <p class="text-muted small mb-0">Agrega una nueva etiqueta para clasificar tus productos</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i>Regresar al catálogo</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label fw-semibold text-secondary small text-uppercase">Nombre de la Categoría <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-folder text-muted"></i></span>
                            <input asp-for="Nombre" class="form-control border-start-0" placeholder="Ej. Electrónica" autofocus/>
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>

                    <hr class="text-muted opacity-25 mb-4"/>

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm"><i class="bi bi-check-lg me-1"></i>Guardar Categoría</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { 
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} 
}