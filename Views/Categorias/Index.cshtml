@model IEnumerable<InventarioApp.Models.Categoria>
@{ ViewData["Title"]="Categorias"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-tags text-primary me-2"></i>Categorias</h2>
        <p class="text-muted mb-0 small">Administra las etiquetas de clasificación de tu inventario</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i>Nueva Categoría</a>
</div>

<div class="card card-d mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="filterForm" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" id="searchQ" value="@ViewBag.Q" class="form-control border-start-0 bg-light" placeholder="Buscar categoría por nombre..."/>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search me-1"></i>Buscar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Q as string)) {
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Limpiar"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div id="table-container" class="position-relative">
    <div id="loading-overlay" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none justify-content-center align-items-center" style="z-index: 10; border-radius: 14px;">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>

    <div class="card card-d border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-secondary">Listado de Categorías</h6>
            <span class="badge bg-light text-dark border">Mostrando @Model.Count() de @ViewBag.TotalItems</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any()) {
                <div class="text-center py-5">
                    <div class="mb-3"><i class="bi bi-tags fs-1 text-muted opacity-50"></i></div>
                    <h5 class="text-muted fw-semibold">No se encontraron categorías</h5>
                    <p class="text-muted small mb-3">Ajusta tu búsqueda o crea una nueva.</p>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Crear nueva categoría</a>
                </div>
            } else {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Nombre</th>
                                <th class="text-center">Productos Asociados</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                        @foreach(var c in Model){
                            <tr>
                                <td class="ps-4 text-muted small">@c.Id</td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.Nombre</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">
                                        @c.Productos.Count Productos
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light border text-primary" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                        <button type="button" onclick="deleteCategoria(@c.Id)" class="btn btn-sm btn-light border text-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1) {
                    <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                        <nav aria-label="Navegación de páginas">
                            <ul class="pagination pagination-sm mb-0 shadow-sm">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" onclick="goToPage(@(ViewBag.CurrentPage - 1))">Anterior</button>
                                </li>
                                @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <button class="page-link" onclick="goToPage(@i)">@i</button>
                                    </li>
                                }
                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <button class="page-link" onclick="goToPage(@(ViewBag.CurrentPage + 1))">Siguiente</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentPage = @(ViewBag.CurrentPage ?? 1);

        document.getElementById('filterForm').addEventListener('submit', function(e) {
            e.preventDefault();
            currentPage = 1;
            loadData();
        });

        function goToPage(page) {
            currentPage = page;
            loadData();
        }

        async function loadData() {
            const q = document.getElementById('searchQ').value;
            const url = `?q=${encodeURIComponent(q)}&page=${currentPage}`;

            document.getElementById('loading-overlay').classList.remove('d-none');
            document.getElementById('loading-overlay').classList.add('d-flex');

            try {
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.querySelector('#table-container').innerHTML;
                document.getElementById('table-container').innerHTML = newContent;
                window.history.pushState({}, '', url);
            } catch (error) {
                console.error('Error fetching data:', error);
                Swal.fire('Error', 'No se pudo cargar la información.', 'error');
            } finally {
                const overlay = document.getElementById('loading-overlay');
                if(overlay) {
                    overlay.classList.add('d-none');
                    overlay.classList.remove('d-flex');
                }
            }
        }

        function deleteCategoria(id) {
            Swal.fire({
                title: '¿Confirmar eliminación?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-trash me-1"></i>Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const formData = new FormData();
                        formData.append('id', id);
                        if (token) formData.append('__RequestVerificationToken', token);

                        // The current controller's delete confirmed endpoint returns a redirect.
                        // Wait, it might have TempData["Error"] if it has products.
                        // Let's handle that by executing and checking response.redirected
                        const response = await fetch(`/Categorias/Delete/${id}`, {
                            method: 'POST',
                            body: formData,
                            // we can choose to follow redirects
                        });

                        // since it redirects to Index usually, we fetch the response html to see if there is an error toast
                        const html = await response.text();
                        if (html.includes("No se puede eliminar")) {
                            Swal.fire('Error', 'No se puede eliminar: tiene productos asociados.', 'error');
                        } else if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Eliminada',
                                text: 'La categoría ha sido eliminada exitosamente.',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                            loadData();
                        } else {
                            throw new Error('Server error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Hubo un problema al intentar eliminar.', 'error');
                    }
                }
            });
        }
    </script>
    @Html.AntiForgeryToken()
}