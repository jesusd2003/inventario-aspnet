@model IEnumerable<InventarioApp.Models.Compra>
@{ ViewData["Title"]="Historial de Compras"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-cart3 text-primary me-2"></i>Compras</h2>
        <p class="text-muted mb-0 small">Registro de compras a proveedores e ingreso de stock</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i>Nueva Compra</a>
</div>

<div class="card card-d mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="filterForm" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" id="searchQ" value="@ViewBag.Q" class="form-control border-start-0 bg-light" placeholder="Buscar por nombre de proveedor o notas..."/>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search me-1"></i>Buscar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Q as string)) {
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Limpiar"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div id="table-container" class="position-relative">
    <div id="loading-overlay" class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none justify-content-center align-items-center" style="z-index: 10; border-radius: 14px;">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>

    <div class="card card-d border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-secondary">Historial de Compras Registradas</h6>
            <span class="badge bg-light text-dark border">Mostrando @Model.Count() de @ViewBag.TotalItems</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any()) {
                <div class="text-center py-5">
                    <div class="mb-3"><i class="bi bi-cart3 fs-1 text-muted opacity-50"></i></div>
                    <h5 class="text-muted fw-semibold">No se encontraron compras</h5>
                    <p class="text-muted small mb-3">Tu búsqueda no arrojó resultados o no hay historial de compras.</p>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Registrar una compra</a>
                </div>
            } else {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th class="text-center">Items</th>
                                <th class="text-end">Total Costo</th>
                                <th class="text-center pe-4">Detalle</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                        @foreach (var c in Model) {
                            <tr>
                                <td class="ps-4 text-muted small fw-mono">#@c.Id.ToString("D5")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.Fecha.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>@c.Fecha.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @if(string.IsNullOrEmpty(c.Proveedor)){
                                        <span class="text-muted small">Proveedor no especificado</span>
                                    } else {
                                        <span class="fw-semibold">@c.Proveedor</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                                        @c.Detalles.Count artículo(s)
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success">
                                    $@c.Total.ToString("N2")
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@c.Id" target="_blank" class="btn btn-sm btn-light border text-info shadow-sm" title="Ver Factura"><i class="bi bi-receipt"></i> Ver Detalle</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1) {
                    <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                        <nav aria-label="Navegación de páginas">
                            <ul class="pagination pagination-sm mb-0 shadow-sm">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" onclick="goToPage(@(ViewBag.CurrentPage - 1))">Anterior</button>
                                </li>
                                @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <button class="page-link" onclick="goToPage(@i)">@i</button>
                                    </li>
                                }
                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <button class="page-link" onclick="goToPage(@(ViewBag.CurrentPage + 1))">Siguiente</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentPage = @(ViewBag.CurrentPage ?? 1);

        document.getElementById('filterForm').addEventListener('submit', function(e) {
            e.preventDefault();
            currentPage = 1;
            loadData();
        });

        function goToPage(page) {
            currentPage = page;
            loadData();
        }

        async function loadData() {
            const q = document.getElementById('searchQ').value;
            const url = `?q=${encodeURIComponent(q)}&page=${currentPage}`;

            document.getElementById('loading-overlay').classList.remove('d-none');
            document.getElementById('loading-overlay').classList.add('d-flex');

            try {
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.querySelector('#table-container').innerHTML;
                document.getElementById('table-container').innerHTML = newContent;
                window.history.pushState({}, '', url);
            } catch (error) {
                console.error('Error fetching data:', error);
                Swal.fire('Error', 'No se pudo cargar la información.', 'error');
            } finally {
                const overlay = document.getElementById('loading-overlay');
                if(overlay) {
                    overlay.classList.add('d-none');
                    overlay.classList.remove('d-flex');
                }
            }
        }
    </script>
}