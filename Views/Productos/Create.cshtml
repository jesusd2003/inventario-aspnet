@model InventarioApp.Models.Producto
@{ ViewData["Title"]="Nuevo Producto"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-primary me-2"></i>Nuevo Producto</h2>
        <p class="text-muted small mb-0">Completa los datos para registrar un nuevo artículo en tu inventario</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i>Regresar al catálogo</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small text-uppercase">Nombre del Producto <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                                <input asp-for="Nombre" class="form-control border-start-0" placeholder="Ej. Lápiz HB" autofocus/>
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small text-uppercase">Descripción (Opcional)</label>
                            <textarea asp-for="Descripcion" class="form-control shadow-sm" rows="3" placeholder="Detalles, marca o características del producto..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label fw-semibold text-secondary small text-uppercase">Precio de Venta <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-success bg-opacity-10 text-success border-end-0">$</span>
                                <input asp-for="Precio" class="form-control border-start-0 fw-bold text-success" step="0.01" placeholder="0.00"/>
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label fw-semibold text-secondary small text-uppercase">Stock Inicial <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-boxes text-muted"></i></span>
                                <input asp-for="Stock" class="form-control border-start-0" min="0" placeholder="0"/>
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CategoriaId" class="form-label fw-semibold text-secondary small text-uppercase">Categoría</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-folder-fill text-warning"></i></span>
                                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select border-start-0">
                                    <option value="">-- Seleccionar Categoría --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CategoriaId" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 mb-4"/>

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm"><i class="bi bi-check-lg me-1"></i>Guardar Producto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { 
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} 
}